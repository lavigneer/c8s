{
  "name": "c8s-dashboard",
  "version": "1.0.0",
  "description": "C8S CI/CD Dashboard UI",
  "scripts": {
    "build:css": "tailwindcss -i ./cmd/api-server/static/css/input.css -o ./cmd/api-server/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./cmd/api-server/static/css/input.css -o ./cmd/api-server/static/css/tailwind.css --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "screenshots": "playwright test --grep @screenshots",
    "screenshots:ui": "playwright test --grep @screenshots --ui",
    "screenshots:debug": "playwright test --grep @screenshots --debug",
    "screenshots:report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.1.18"
  }
}
