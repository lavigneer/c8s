{
  "name": "c8s-dashboard",
  "version": "1.0.0",
  "description": "C8S CI/CD Dashboard UI",
  "scripts": {
    "build:css": "tailwindcss -i ./cmd/api-server/static/css/input.css -o ./cmd/api-server/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./cmd/api-server/static/css/input.css -o ./cmd/api-server/static/css/tailwind.css --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.40.0",
    "tailwindcss": "^3.3.0"
  }
}
