# Dockerfile for Tilt Development
# Optimized for fast rebuilds with locally-compiled binaries
# Uses COPY to include the precompiled binary and allows syncing of templates/static
FROM alpine:3.18
RUN apk add --no-cache ca-certificates
WORKDIR /app

# Copy the locally-compiled binary
# This is built by the local_resource 'api-server-compile' before docker build runs
COPY bin/api-server /app/api-server

# Copy templates and static assets
# These can be live-synced for faster development iteration
COPY cmd/api-server/templates ./templates
COPY cmd/api-server/static ./static

# Create directories with proper permissions for live_update
RUN mkdir -p /app/templates /app/static && chmod 777 /app /app/templates /app/static

EXPOSE 8080

ENTRYPOINT ["/app/api-server"]
CMD ["-base-dir", "/app"]
