# Dockerfile for Tilt Development
# Optimized for fast rebuilds with locally-compiled binaries
# The binary and assets are synced via docker_build_with_restart live_update
FROM alpine:3.18
RUN apk add --no-cache ca-certificates
WORKDIR /app

# Create a placeholder binary file
# This will be immediately replaced by the live_update sync of bin/api-server
ADD bin bin

# Copy templates and static assets from source
# These will also be synced via live_update for development
COPY cmd/api-server/templates ./templates
COPY cmd/api-server/static ./static

# Create directories with proper permissions for live_update
RUN mkdir -p /app/templates /app/static /app/bin && chmod -R 777 /app /app/templates /app/static

EXPOSE 8080

ENTRYPOINT ["/app/bin/api-server"]
CMD ["-base-dir", "/app"]
