{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C8S Deployment Configuration",
  "description": "Configuration schema for deploying C8S stack to Kubernetes",
  "type": "object",
  "required": ["metadata", "cluster", "environment"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable deployment name",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "description": "C8S version to deploy (e.g., 'v0.2.0', 'latest')",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cluster": {
      "type": "object",
      "required": ["namespace"],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "Kubernetes namespace for deployment",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "kubeconfig": {
          "type": "string",
          "description": "Path to kubeconfig file"
        },
        "context": {
          "type": "string",
          "description": "Kubernetes context name"
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "controller": {
          "$ref": "#/definitions/ComponentConfig"
        },
        "webhook": {
          "$ref": "#/definitions/ComponentConfig"
        },
        "apiServer": {
          "$ref": "#/definitions/ComponentConfig"
        },
        "database": {
          "$ref": "#/definitions/ComponentConfig"
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["s3-compatible", "pvc", "local"],
          "default": "s3-compatible"
        },
        "s3Config": {
          "$ref": "#/definitions/S3StorageConfig"
        },
        "pvcConfig": {
          "$ref": "#/definitions/PVCStorageConfig"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["dev", "staging", "production"],
          "default": "dev"
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info"
        },
        "replicas": {
          "type": "object",
          "properties": {
            "controller": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "webhook": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "apiServer": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        }
      }
    },
    "resources": {
      "$ref": "#/definitions/ResourceRequirements"
    },
    "authentication": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "type": {
          "type": "string",
          "enum": ["basic", "oauth2", "saml"],
          "default": "basic"
        },
        "secretRef": {
          "type": "string",
          "description": "Reference to Kubernetes secret containing auth credentials"
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "certPath": {
          "type": "string",
          "description": "Path to TLS certificate file"
        },
        "keyPath": {
          "type": "string",
          "description": "Path to TLS key file"
        },
        "secretRef": {
          "type": "string",
          "description": "Reference to Kubernetes secret containing cert/key"
        }
      }
    }
  },
  "definitions": {
    "ComponentConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "image": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "string",
              "default": "docker.io",
              "pattern": "^[a-zA-Z0-9.-]+(:[0-9]+)?$"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"],
              "default": "IfNotPresent"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "port": {
          "type": "object",
          "properties": {
            "containerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "servicePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/ResourceRequirements"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object",
                "properties": {
                  "configMapKeyRef": {
                    "type": "object",
                    "required": ["name", "key"],
                    "properties": {
                      "name": { "type": "string" },
                      "key": { "type": "string" }
                    }
                  },
                  "secretKeyRef": {
                    "type": "object",
                    "required": ["name", "key"],
                    "properties": {
                      "name": { "type": "string" },
                      "key": { "type": "string" }
                    }
                  },
                  "fieldRef": {
                    "type": "object",
                    "required": ["fieldPath"],
                    "properties": {
                      "fieldPath": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "livenessProbe": {
          "$ref": "#/definitions/Probe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/Probe"
        }
      }
    },
    "Probe": {
      "type": "object",
      "properties": {
        "httpGet": {
          "type": "object",
          "required": ["path", "port"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ResourceRequirements": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "#/definitions/ResourceLimit"
        },
        "limits": {
          "$ref": "#/definitions/ResourceLimit"
        }
      }
    },
    "ResourceLimit": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "description": "CPU request/limit (e.g., '100m', '1', '2000m')",
          "pattern": "^[0-9]+(m|Mi|Gi|m)?$"
        },
        "memory": {
          "type": "string",
          "description": "Memory request/limit (e.g., '256Mi', '512Mi', '1Gi')",
          "pattern": "^[0-9]+(Mi|Gi|M|G)$"
        }
      }
    },
    "S3StorageConfig": {
      "type": "object",
      "required": ["endpoint", "bucket"],
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "S3 endpoint URL"
        },
        "bucket": {
          "type": "string",
          "description": "S3 bucket name",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "region": {
          "type": "string",
          "default": "us-east-1"
        },
        "accessKey": {
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "useSSL": {
          "type": "boolean",
          "default": false
        },
        "insecureSkipVerify": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "PVCStorageConfig": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Gi|Mi|G|M)$"
        },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"],
          "default": "ReadWriteOnce"
        }
      }
    }
  }
}
