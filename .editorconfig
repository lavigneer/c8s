# EditorConfig for C8S
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go source files
[*.go]
indent_style = tab
indent_size = 4

# Makefiles require tabs
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# YAML files
[*.{yaml,yml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files (preserve trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# TypeScript/JavaScript (for E2E tests)
[*.{ts,js,tsx,jsx}]
indent_size = 2

# HTML templates
[*.html]
indent_size = 2

# Dockerfile
[Dockerfile*]
indent_size = 2

# Configuration files
[*.{toml,ini,conf}]
indent_size = 2

# Git commit messages
[COMMIT_EDITMSG]
max_line_length = 72
